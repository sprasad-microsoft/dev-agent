{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dev-agent.local/schemas/history.schema.json",
  "title": "Untriaged repository review history",
  "type": "object", "additionalProperties": false, "required": ["schemaVersion", "repository", "records"],
  "properties": {
    "schemaVersion": {"const": 1}, "repository": {"$ref": "project.schema.json#/$defs/repository"},
    "records": {
      "type": "array", "maxItems": 100,
      "items": {
        "type": "object", "additionalProperties": false, "required": ["sourceUrl", "path", "line", "body", "createdAt", "pullRequestUrl", "classification"],
        "properties": {
          "sourceUrl": {"type": "string", "format": "uri"}, "path": {"$ref": "feature.schema.json#/$defs/text"},
          "line": {"type": ["integer", "null"], "minimum": 1}, "body": {"type": "string"},
          "createdAt": {"$ref": "feature.schema.json#/$defs/timestamp"}, "pullRequestUrl": {"type": "string", "format": "uri"}, "classification": {"const": "untriaged"}
        }
      }
    }
  }
}
